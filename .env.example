# ─────────────────────────────────────────────────────────────────────────────
# EcoMora — Environment Variables
# Copy this file to .env and fill in the values before running the project.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI ────────────────────────────────────────────────────────────────────────
# OpenAI API key — used for GPT-4o species identification and Q&A chat.
OPENAI_API_KEY=sk-...

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret key used to sign JWT access tokens.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-hex-string

# JWT algorithm (default HS256) and token expiry in minutes (default 60)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
# SQLAlchemy connection URL.
# In Docker Compose the DB lives on a named volume at /app/data/ecomora.db.
# For manual local dev you can use a relative path instead.
DATABASE_URL=sqlite:////app/data/ecomora.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (used by FastAPI CORS middleware).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost
